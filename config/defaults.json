{
  "app": {
    "menubar": false,
    "single_instance": true
  },
  "config": {
    "hot_reload": true
  },
  "control": {
    "socket": ""
  },
  "kb": {
    "base_url": "",
    "dir": "",
    "embedder": "hash",
    "model": "nomic-embed-text"
  },
  "license": {
    "holder": "",
    "spdx": "LicenseRef-Undecided"
  },
  "llm": {
    "api_key_name": "OATS_LLM_API_KEY",
    "backend": "ollama",
    "base_url": "",
    "model": "llama3.1"
  },
  "network": {
    "allow": false
  },
  "notes": {
    "enforce_headings": true
  },
  "privacy": {
    "hide_from_capture": true,
    "hide_method": "none"
  },
  "secrets": {
    "keychain_service": "oats-meetings-rs",
    "source": "env"
  },
  "sessions": {
    "confirm_delete": true,
    "delete_mode": "trash",
    "root": ""
  },
  "stt": {
    "backend": "local",
    "cloud": {
      "adapter": "none"
    },
    "local": {
      "model": "base.en"
    }
  },
  "templates": {
    "dir": ""
  }
}
