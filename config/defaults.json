{
  "app": {
    "menubar": false,
    "single_instance": true
  },
  "audio": {
    "backend": "auto",
    "layout": "split",
    "mic": {
      "device": "",
      "enabled": true
    },
    "open_timeout": "15s",
    "poll_interval": "25ms",
    "system": {
      "device": "",
      "enabled": true
    },
    "transcribe": "auto"
  },
  "config": {
    "hot_reload": true,
    "poll_interval": "250ms"
  },
  "control": {
    "accept_backoff": "50ms",
    "accept_poll": "10ms",
    "client_timeout": "10s",
    "drain_chunk": 65536,
    "drain_max": 8388608,
    "event_queue": 256,
    "max_line": 1048576,
    "socket": ""
  },
  "ics": {
    "all_day": "include",
    "allow_file": true,
    "cache_dir": "",
    "cancelled": "hide",
    "default_refresh": "15m",
    "default_tz": "UTC",
    "enabled": true,
    "feeds": "[]",
    "max_bytes": 5242880,
    "max_name_len": 64,
    "max_occurrences": 500,
    "on_bad_event": "error",
    "poll_interval": "1s",
    "stale_on_error": true,
    "timeout": "15s",
    "unknown_tz": "error",
    "webcal_scheme": "https",
    "window_days": 7
  },
  "kb": {
    "base_url": "",
    "dir": "",
    "embedder": "hash",
    "hash_dims": 256,
    "max_chunk": 1200,
    "min_chunk": 20,
    "model": "nomic-embed-text",
    "timeout": "2m"
  },
  "license": {
    "holder": "",
    "spdx": "LicenseRef-Undecided"
  },
  "llm": {
    "api_key_ref": "secret:llm/api-key",
    "backend": "ollama",
    "base_url": "",
    "model": "llama3.1",
    "timeout": "2m"
  },
  "network": {
    "allow": false,
    "error_snippet": 300
  },
  "notes": {
    "confirm_regenerate": true,
    "default_template": "",
    "enforce_headings": true
  },
  "privacy": {
    "hide_from_capture": true,
    "hide_method": "none"
  },
  "secrets": {
    "backend": "env-then-keyring",
    "env_prefix": "OATS_SECRET_",
    "keyring_service": "oats-meetings-rs",
    "max_key_len": 128
  },
  "sessions": {
    "confirm_delete": true,
    "delete_mode": "trash",
    "max_id_len": 200,
    "root": "",
    "search_snippet_chars": 40
  },
  "stt": {
    "backend": "local",
    "cloud": {
      "adapter": "none",
      "key": "secret:stt/cloud",
      "max_response": 8388608,
      "model": "whisper-1",
      "timeout": "1m",
      "url": "https://api.openai.com/v1"
    },
    "feed": "500ms",
    "final": {
      "enabled": true
    },
    "final_piece": "10m",
    "language": "en",
    "live": {
      "chunk": "4s",
      "enabled": true
    },
    "local": {
      "auto_download": true,
      "engine": "whisper",
      "model": "base.en",
      "model_path": "",
      "model_url": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main",
      "models_dir": "",
      "threads": 4
    },
    "pad": "250ms",
    "speaker_them": "remote_1",
    "speaker_you": "you",
    "speech_peak": 10
  },
  "templates": {
    "dir": ""
  },
  "ui": {
    "live_follow": true,
    "live_max_lines": 2000,
    "record_controls": true,
    "show_elapsed": true,
    "speaker_width": 96,
    "tick": "100ms",
    "tz": ""
  }
}
