{
  "app": {
    "menubar": false,
    "single_instance": true
  },
  "config": {
    "hot_reload": true
  },
  "control": {
    "socket": ""
  },
  "ics": {
    "all_day": "include",
    "allow_file": true,
    "cache_dir": "",
    "cancelled": "hide",
    "default_refresh_secs": "900",
    "default_tz": "UTC",
    "enabled": true,
    "feeds": "[]",
    "max_bytes": "5242880",
    "max_occurrences": "500",
    "on_bad_event": "error",
    "stale_on_error": true,
    "timeout_secs": "15",
    "unknown_tz": "error",
    "webcal_scheme": "https",
    "window_days": "7"
  },
  "license": {
    "holder": "",
    "spdx": "LicenseRef-Undecided"
  },
  "llm": {
    "backend": "ollama"
  },
  "network": {
    "allow": false
  },
  "privacy": {
    "hide_from_capture": true,
    "hide_method": "none"
  },
  "sessions": {
    "confirm_delete": true,
    "root": ""
  },
  "stt": {
    "backend": "local",
    "cloud": {
      "adapter": "none"
    },
    "local": {
      "model": "base.en"
    }
  }
}
