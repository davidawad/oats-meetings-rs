          "x-max": "1s",
          "x-max-ms": 1000,
          "x-min": "1ms",
          "x-min-ms": 1,
          "x-reload": "live",
          "x-ui": false
        },
        "client_timeout": {
          "default": "10s",
          "description": "Default wait of oats-ctl for events or for an engine that is still starting (its --timeout-ms flag overrides).",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "1h",
          "x-max-ms": 3600000,
          "x-min": "100ms",
          "x-min-ms": 100,
          "x-reload": "live",
          "x-ui": false
        },
        "event_queue": {
          "default": 256,
          "description": "Events queued per subscriber before a slow one is dropped.",
          "maximum": 65536,
          "minimum": 1,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "max_line": {
          "default": 1048576,
          "description": "Largest control-socket request line, in bytes; longer lines are refused.",
          "maximum": 67108864,
          "minimum": 1024,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "socket": {
          "default": "",
          "description": "Control socket path; empty means the per-user runtime dir.",
          "type": "string",
          "x-reload": "rebind",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "ics": {
      "additionalProperties": false,
      "properties": {
        "all_day": {
