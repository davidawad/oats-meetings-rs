          "x-ui": true
        },
        "max_bytes": {
          "default": 5242880,
          "description": "Largest feed body accepted, in bytes.",
          "maximum": 1073741824,
          "minimum": 1,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "max_name_len": {
          "default": 64,
          "description": "Longest feed name.",
          "maximum": 255,
          "minimum": 1,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "max_occurrences": {
          "default": 500,
          "description": "Most occurrences expanded per recurring event per query.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "on_bad_event": {
          "default": "error",
          "description": "A malformed event fails the whole feed (error) or is dropped and counted (skip).",
          "enum": [
            "error",
            "skip"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "poll_interval": {
          "default": "1s",
          "description": "How often the feed scheduler checks which feeds are due.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "1h",
          "x-max-ms": 3600000,
          "x-min": "100ms",
          "x-min-ms": 100,
          "x-reload": "live",
          "x-ui": false
        },
        "stale_on_error": {
          "default": true,
          "description": "When a refresh fails, keep serving the last good cached copy.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "timeout": {
          "default": "15s",
          "description": "Whole-request timeout for a feed fetch.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "10m",
          "x-max-ms": 600000,
          "x-min": "1s",
          "x-min-ms": 1000,
          "x-reload": "live",
          "x-ui": false
        },
        "unknown_tz": {
