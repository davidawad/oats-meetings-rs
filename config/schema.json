{
  "$comment": "GENERATED by `oats-meetings-rs config generate` from crates/core/src/config/keys.rs; do not edit",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "menubar": {
          "default": false,
          "description": "Show a menubar / tray item.",
          "type": "boolean",
          "x-ui": true
        },
        "single_instance": {
          "default": true,
          "description": "Refuse to start a second engine on the same control socket.",
          "type": "boolean",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "audio": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "auto",
          "description": "Capture backend: auto picks per OS (Linux: pulse, else pipewire; Windows: cpal/WASAPI).",
          "enum": [
            "auto",
            "pulse",
            "pipewire",
            "cpal"
          ],
          "type": "string",
          "x-ui": true
        },
        "layout": {
          "default": "split",
          "description": "WAV layout: split is two channels (left system audio, right mic); mix is one summed channel.",
          "enum": [
            "split",
            "mix"
          ],
          "type": "string",
          "x-ui": true
        },
        "mic": {
          "additionalProperties": false,
          "properties": {
            "device": {
              "default": "",
              "description": "Microphone device id (see `ctl devices list`); empty means the default mic.",
              "type": "string",
              "x-ui": true
            },
            "enabled": {
              "default": true,
              "description": "Record the microphone.",
              "type": "boolean",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "record_dir": {
          "default": "",
          "description": "Directory recordings are written under (one folder per session); empty means the per-user sessions dir.",
          "type": "string",
          "x-ui": true
        },
        "system": {
          "additionalProperties": false,
          "properties": {
            "device": {
              "default": "",
              "description": "System-audio loopback device id (see `ctl devices list`); empty means the default loopback.",
              "type": "string",
              "x-ui": true
            },
            "enabled": {
              "default": true,
              "description": "Record system audio (what the machine plays).",
              "type": "boolean",
              "x-ui": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "hot_reload": {
          "default": true,
          "description": "Watch the user config file and reload on change.",
          "type": "boolean",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "socket": {
          "default": "",
          "description": "Control socket path; empty means the per-user runtime dir.",
          "type": "string",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "license": {
      "additionalProperties": false,
      "properties": {
        "holder": {
          "default": "",
          "description": "Licence holder metadata (placeholder; no licence chosen).",
          "type": "string",
          "x-ui": false
        },
        "spdx": {
          "default": "LicenseRef-Undecided",
          "description": "SPDX expression for packaging metadata (placeholder).",
          "type": "string",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "llm": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "ollama",
          "description": "Notes-generation LLM backend.",
          "enum": [
            "ollama",
            "openrouter",
            "openai-compatible"
          ],
          "type": "string",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": false,
          "description": "Allow outward network calls (cloud STT / LLM). Off means such backends are denied.",
          "type": "boolean",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "privacy": {
      "additionalProperties": false,
      "properties": {
        "hide_from_capture": {
          "default": true,
          "description": "Hide the app window from screen capture.",
          "type": "boolean",
          "x-ui": true
        },
        "hide_method": {
          "default": "none",
          "description": "How hiding is done; set per OS by the os axis.",
          "enum": [
            "none",
            "sharing_type",
            "display_affinity"
          ],
          "type": "string",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "stt": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "local",
          "description": "Speech-to-text backend: on-device or a cloud adapter.",
          "enum": [
            "local",
            "cloud"
          ],
          "type": "string",
          "x-ui": true
        },
        "cloud": {
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "default": "none",
              "description": "Cloud STT adapter; must not be none when stt.backend is cloud.",
              "enum": [
                "none",
                "openai-compatible"
              ],
              "type": "string",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "local": {
          "additionalProperties": false,
          "properties": {
            "model": {
              "default": "base.en",
              "description": "Local ASR model name.",
              "type": "string",
              "x-ui": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "title": "oats-meetings-rs config",
  "type": "object"
}
