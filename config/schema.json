            "auto",
            "on",
            "off"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "hot_reload": {
