{
  "$comment": "GENERATED by `oats-meetings-rs config generate` from crates/core/src/config/keys.rs; do not edit",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "menubar": {
          "default": false,
          "description": "Show a menubar / tray item.",
          "type": "boolean",
          "x-ui": true
        },
        "single_instance": {
          "default": true,
          "description": "Refuse to start a second engine on the same control socket.",
          "type": "boolean",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "hot_reload": {
          "default": true,
          "description": "Watch the user config file and reload on change.",
          "type": "boolean",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "socket": {
          "default": "",
          "description": "Control socket path; empty means the per-user runtime dir.",
          "type": "string",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "license": {
      "additionalProperties": false,
      "properties": {
        "holder": {
          "default": "",
          "description": "Licence holder metadata (placeholder; no licence chosen).",
          "type": "string",
          "x-ui": false
        },
        "spdx": {
          "default": "LicenseRef-Undecided",
          "description": "SPDX expression for packaging metadata (placeholder).",
          "type": "string",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "llm": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "ollama",
          "description": "Notes-generation LLM backend.",
          "enum": [
            "ollama",
            "openrouter",
            "openai-compatible"
          ],
          "type": "string",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": false,
          "description": "Allow outward network calls (cloud STT / LLM). Off means such backends are denied.",
          "type": "boolean",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "privacy": {
      "additionalProperties": false,
      "properties": {
        "hide_from_capture": {
          "default": true,
          "description": "Hide the app window from screen capture.",
          "type": "boolean",
          "x-ui": true
        },
        "hide_method": {
          "default": "none",
          "description": "How hiding is done; set per OS by the os axis.",
          "enum": [
            "none",
            "sharing_type",
            "display_affinity"
          ],
          "type": "string",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "sessions": {
      "additionalProperties": false,
      "properties": {
        "confirm_delete": {
          "default": true,
          "description": "Require confirm=true to delete a session.",
          "type": "boolean",
          "x-ui": true
        },
        "root": {
          "default": "",
          "description": "Session store directory (OpenOats layout); empty means the per-user data dir.",
          "type": "string",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "stt": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "local",
          "description": "Speech-to-text backend: on-device or a cloud adapter.",
          "enum": [
            "local",
            "cloud"
          ],
          "type": "string",
          "x-ui": true
        },
        "cloud": {
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "default": "none",
              "description": "Cloud STT adapter; must not be none when stt.backend is cloud.",
              "enum": [
                "none",
                "openai-compatible"
              ],
              "type": "string",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "local": {
          "additionalProperties": false,
          "properties": {
            "model": {
              "default": "base.en",
              "description": "Local ASR model name.",
              "type": "string",
              "x-ui": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "title": "oats-meetings-rs config",
  "type": "object"
}
