{
  "$comment": "GENERATED by `oats-meetings-rs config generate` from crates/core/src/config/keys.rs; do not edit",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "menubar": {
          "default": false,
          "description": "Show a menubar / tray item.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "single_instance": {
          "default": true,
          "description": "Refuse to start a second engine on the same control socket.",
          "type": "boolean",
          "x-reload": "lock",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "hot_reload": {
          "default": true,
          "description": "Watch the user config file and reload on change.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "socket": {
          "default": "",
          "description": "Control socket path; empty means the per-user runtime dir.",
          "type": "string",
          "x-reload": "rebind",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "ics": {
      "additionalProperties": false,
      "properties": {
        "all_day": {
          "default": "include",
          "description": "Whether all-day events appear in ics-events.",
          "enum": [
            "include",
            "exclude"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "allow_file": {
          "default": true,
          "description": "Allow file:// feeds (local, not gated by network.allow).",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "cache_dir": {
          "default": "",
          "description": "Directory for cached feeds; empty means ics/ beside the sessions dir.",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        },
        "cancelled": {
          "default": "hide",
          "description": "Whether STATUS:CANCELLED events appear in ics-events.",
          "enum": [
            "hide",
            "show"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "default_refresh_secs": {
          "default": "900",
          "description": "Seconds between automatic refreshes of a feed with no refresh_secs of its own; 0 means manual only.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "default_tz": {
          "default": "UTC",
          "description": "IANA zone for floating times and for the midnight bounds of all-day events.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "enabled": {
          "default": true,
          "description": "Master switch for refreshing feeds (manual and scheduled). Cached events stay readable.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "feeds": {
          "default": "[]",
          "description": "JSON array of feeds: {name, url, enabled, refresh_secs, header}. Edit with ics-add / ics-remove.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "max_bytes": {
          "default": "5242880",
          "description": "Largest feed body accepted, in bytes.",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        },
        "max_occurrences": {
          "default": "500",
          "description": "Most occurrences expanded per recurring event per query.",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        },
        "on_bad_event": {
          "default": "error",
          "description": "A malformed event fails the whole feed (error) or is dropped and counted (skip).",
          "enum": [
            "error",
            "skip"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "stale_on_error": {
          "default": true,
          "description": "When a refresh fails, keep serving the last good cached copy.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "timeout_secs": {
          "default": "15",
          "description": "Whole-request timeout for a feed fetch, in seconds.",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        },
        "unknown_tz": {
          "default": "error",
          "description": "An unknown TZID fails the event (error) or falls back to ics.default_tz.",
          "enum": [
            "error",
            "default_tz"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "webcal_scheme": {
          "default": "https",
          "description": "Scheme webcal:// URLs are fetched with.",
          "enum": [
            "https",
            "http"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "window_days": {
          "default": "7",
          "description": "Default length of the ics-events window in days when no end is given.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "license": {
      "additionalProperties": false,
      "properties": {
        "holder": {
          "default": "",
          "description": "Licence holder metadata (placeholder; no licence chosen).",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        },
        "spdx": {
          "default": "LicenseRef-Undecided",
          "description": "SPDX expression for packaging metadata (placeholder).",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "llm": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "ollama",
          "description": "Notes-generation LLM backend.",
          "enum": [
            "ollama",
            "openrouter",
            "openai-compatible"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": false,
          "description": "Allow outward network calls (cloud STT / LLM). Off means such backends are denied.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "privacy": {
      "additionalProperties": false,
      "properties": {
        "hide_from_capture": {
          "default": true,
          "description": "Hide the app window from screen capture.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "hide_method": {
          "default": "none",
          "description": "How hiding is done; set per OS by the os axis.",
          "enum": [
            "none",
            "sharing_type",
            "display_affinity"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "sessions": {
      "additionalProperties": false,
      "properties": {
        "confirm_delete": {
          "default": true,
          "description": "Require confirm=true to delete a session.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "delete_mode": {
          "default": "trash",
          "description": "Deleting a session moves it to the OS trash (trash) or removes it for good (remove). Provisional default.",
          "enum": [
            "trash",
            "remove"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "root": {
          "default": "",
          "description": "Session store directory (OpenOats layout); empty means the per-user data dir.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "stt": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "local",
          "description": "Speech-to-text backend: on-device or a cloud adapter.",
          "enum": [
            "local",
            "cloud"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "cloud": {
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "default": "none",
              "description": "Cloud STT adapter; must not be none when stt.backend is cloud.",
              "enum": [
                "none",
                "openai-compatible"
              ],
              "type": "string",
              "x-reload": "live",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "local": {
          "additionalProperties": false,
          "properties": {
            "model": {
              "default": "base.en",
              "description": "Local ASR model name.",
              "type": "string",
              "x-reload": "live",
              "x-ui": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "title": "oats-meetings-rs config",
  "type": "object"
}
