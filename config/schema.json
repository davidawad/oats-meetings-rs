          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "10m",
          "x-max-ms": 600000,
          "x-min": "10ms",
          "x-min-ms": 10,
          "x-reload": "live",
          "x-ui": false
        }
      },
      "type": "object"
