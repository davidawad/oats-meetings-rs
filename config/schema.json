{
  "$comment": "GENERATED by `oats-meetings-rs config generate` from crates/core/src/config/keys.rs; do not edit",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "menubar": {
          "default": false,
          "description": "Show a menubar / tray item.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
