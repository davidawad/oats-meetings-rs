          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "10m",
          "x-max-ms": 600000,
          "x-min": "1s",
          "x-min-ms": 1000,
          "x-reload": "live",
          "x-ui": false
        },
        "unknown_tz": {
          "default": "error",
