          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "1h",
          "x-max-ms": 3600000,
          "x-min": "100ms",
          "x-min-ms": 100,
          "x-reload": "live",
          "x-ui": false
        },
        "stale_on_error": {
          "default": true,
          "description": "When a refresh fails, keep serving the last good cached copy.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "timeout": {
          "default": "15s",
          "description": "Whole-request timeout for a feed fetch.",
