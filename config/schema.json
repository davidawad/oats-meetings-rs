          "enum": [
            "error",
            "default_tz"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "webcal_scheme": {
          "default": "https",
          "description": "Scheme webcal:// URLs are fetched with.",
          "enum": [
            "https",
            "http"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "window_days": {
          "default": 7,
          "description": "Default length of the ics-events window in days when no end is given.",
          "maximum": 36500,
          "minimum": 1,
          "type": "integer",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "kb": {
      "additionalProperties": false,
