{
  "$comment": "GENERATED by `oats-meetings-rs config generate` from crates/core/src/config/keys.rs; do not edit",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "menubar": {
          "default": false,
          "description": "Show a menubar / tray item.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "single_instance": {
          "default": true,
          "description": "Refuse to start a second engine on the same control socket.",
          "type": "boolean",
          "x-reload": "lock",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "audio": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "auto",
          "description": "Capture backend: auto picks per OS (Linux: pulse, else pipewire; Windows: cpal/WASAPI; macOS: screencapturekit).",
          "enum": [
            "auto",
            "pulse",
            "pipewire",
            "cpal",
            "screencapturekit"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "layout": {
          "default": "split",
          "description": "WAV layout: split is two channels (left system audio, right mic); mix is one summed channel.",
          "enum": [
            "split",
            "mix"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "mic": {
          "additionalProperties": false,
          "properties": {
            "device": {
              "default": "",
              "description": "Microphone device id (see `ctl devices list`); empty means the default mic.",
              "type": "string",
              "x-reload": "live",
              "x-ui": true
            },
            "enabled": {
              "default": true,
              "description": "Record the microphone.",
              "type": "boolean",
              "x-reload": "live",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "open_timeout": {
          "default": "15s",
          "description": "How long a capture backend waits for audio to start flowing before giving up.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "5m",
          "x-max-ms": 300000,
          "x-min": "1s",
          "x-min-ms": 1000,
          "x-reload": "live",
          "x-ui": false
        },
        "poll_interval": {
          "default": "25ms",
          "description": "Pause of the recorder writer and of capture readiness polling.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "1s",
          "x-max-ms": 1000,
          "x-min": "5ms",
          "x-min-ms": 5,
          "x-reload": "live",
          "x-ui": false
        },
        "system": {
          "additionalProperties": false,
          "properties": {
            "device": {
              "default": "",
              "description": "System-audio loopback device id (see `ctl devices list`); empty means the default loopback.",
              "type": "string",
              "x-reload": "live",
              "x-ui": true
            },
            "enabled": {
              "default": true,
              "description": "Record system audio (what the machine plays).",
              "type": "boolean",
              "x-reload": "live",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "transcribe": {
          "default": "auto",
          "description": "Transcribe while recording (stt.* settings): on fails record-start if the ASR is unavailable, auto records audio only then, off never transcribes.",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "hot_reload": {
          "default": true,
          "description": "Watch the user config file and reload on change.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "poll_interval": {
          "default": "250ms",
          "description": "How often the user config file is checked for changes while config.hot_reload is on.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "10m",
          "x-max-ms": 600000,
          "x-min": "10ms",
          "x-min-ms": 10,
          "x-reload": "live",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "accept_backoff": {
          "default": "50ms",
          "description": "Wait after an accept error before trying again.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "10s",
          "x-max-ms": 10000,
          "x-min": "1ms",
          "x-min-ms": 1,
          "x-reload": "live",
          "x-ui": false
        },
        "accept_poll": {
          "default": "10ms",
          "description": "Idle wait of the control-socket accept loop between checks.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "1s",
          "x-max-ms": 1000,
          "x-min": "1ms",
          "x-min-ms": 1,
          "x-reload": "live",
          "x-ui": false
        },
        "client_timeout": {
          "default": "10s",
          "description": "Default wait of oats-ctl for events or for an engine that is still starting (its --timeout-ms flag overrides).",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "1h",
          "x-max-ms": 3600000,
          "x-min": "100ms",
          "x-min-ms": 100,
          "x-reload": "live",
          "x-ui": false
        },
        "drain_chunk": {
          "default": 65536,
          "description": "Bytes read per step while discarding the rest of an oversize request line.",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "drain_max": {
          "default": 8388608,
          "description": "Most bytes discarded from one oversize request line before the connection is closed.",
          "maximum": 1073741824,
          "minimum": 1024,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "event_queue": {
          "default": 256,
          "description": "Events queued per subscriber before a slow one is dropped.",
          "maximum": 65536,
          "minimum": 1,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "max_line": {
          "default": 1048576,
          "description": "Largest control-socket request line, in bytes; longer lines are refused.",
          "maximum": 67108864,
          "minimum": 1024,
          "type": "integer",
          "x-reload": "live",
          "x-ui": false
        },
        "socket": {
          "default": "",
          "description": "Control socket path; empty means the per-user runtime dir.",
          "type": "string",
          "x-reload": "rebind",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "ics": {
      "additionalProperties": false,
      "properties": {
        "all_day": {
          "default": "include",
          "description": "Whether all-day events appear in ics-events.",
          "enum": [
            "include",
            "exclude"
