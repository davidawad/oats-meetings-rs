          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "30d",
          "x-max-ms": 2592000000,
          "x-min": "0s",
          "x-min-ms": 0,
          "x-reload": "live",
          "x-ui": true
        },
        "default_tz": {
          "default": "UTC",
          "description": "IANA zone for floating times and for the midnight bounds of all-day events.",
