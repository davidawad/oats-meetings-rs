{
  "$comment": "GENERATED by `oats-meetings-rs config generate` from crates/core/src/config/keys.rs; do not edit",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "menubar": {
          "default": false,
          "description": "Show a menubar / tray item.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "single_instance": {
          "default": true,
          "description": "Refuse to start a second engine on the same control socket.",
          "type": "boolean",
          "x-reload": "lock",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "hot_reload": {
          "default": true,
          "description": "Watch the user config file and reload on change.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "socket": {
          "default": "",
          "description": "Control socket path; empty means the per-user runtime dir.",
          "type": "string",
          "x-reload": "rebind",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "kb": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "default": "",
          "description": "Embedding endpoint base URL for kb.embedder ollama / openai-compatible.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "dir": {
          "default": "",
          "description": "Knowledge-base folder of .md/.txt files; empty means <data dir>/kb.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "embedder": {
          "default": "hash",
          "description": "KB embedder: local deterministic hashing, or a model endpoint (gated by network.allow unless loopback).",
          "enum": [
            "hash",
            "ollama",
            "openai-compatible"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "model": {
          "default": "nomic-embed-text",
          "description": "Embedding model name for the ollama / openai-compatible embedders.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "license": {
      "additionalProperties": false,
      "properties": {
        "holder": {
          "default": "",
          "description": "Licence holder metadata (placeholder; no licence chosen).",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        },
        "spdx": {
          "default": "LicenseRef-Undecided",
          "description": "SPDX expression for packaging metadata (placeholder).",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "llm": {
      "additionalProperties": false,
      "properties": {
        "api_key_name": {
          "default": "OATS_LLM_API_KEY",
          "description": "NAME of the secret holding the LLM API key (env var or keychain account). The key itself is never in config.",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        },
        "backend": {
          "default": "ollama",
          "description": "Notes-generation LLM backend.",
          "enum": [
            "ollama",
            "openrouter",
            "openai-compatible"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "base_url": {
          "default": "",
          "description": "LLM endpoint base URL; empty means the backend default (required for openai-compatible).",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "model": {
          "default": "llama3.1",
          "description": "Model name sent to the LLM backend.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": false,
          "description": "Allow outward network calls (cloud STT / LLM). Off means such backends are denied.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "notes": {
      "additionalProperties": false,
      "properties": {
        "enforce_headings": {
          "default": true,
          "description": "Reject generated notes that lack a '## ' heading the template's prompt demands.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "privacy": {
      "additionalProperties": false,
      "properties": {
        "hide_from_capture": {
          "default": true,
          "description": "Hide the app window from screen capture.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "hide_method": {
          "default": "none",
          "description": "How hiding is done; set per OS by the os axis.",
          "enum": [
            "none",
            "sharing_type",
            "display_affinity"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        }
      },
      "type": "object"
    },
    "secrets": {
      "additionalProperties": false,
      "properties": {
        "keychain_service": {
          "default": "oats-meetings-rs",
          "description": "Keychain service name used when secrets.source = keychain.",
          "type": "string",
          "x-reload": "live",
          "x-ui": false
        },
        "source": {
          "default": "env",
          "description": "Where API keys are read from: process environment or the OS keychain.",
          "enum": [
            "env",
            "keychain"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "sessions": {
      "additionalProperties": false,
      "properties": {
        "confirm_delete": {
          "default": true,
          "description": "Require confirm=true to delete a session.",
          "type": "boolean",
          "x-reload": "live",
          "x-ui": true
        },
        "delete_mode": {
          "default": "trash",
          "description": "Deleting a session moves it to the OS trash (trash) or removes it for good (remove). Provisional default.",
          "enum": [
            "trash",
            "remove"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "root": {
          "default": "",
          "description": "Session store directory (OpenOats layout); empty means the per-user data dir.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "stt": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "local",
          "description": "Speech-to-text backend: on-device or a cloud adapter.",
          "enum": [
            "local",
            "cloud"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "cloud": {
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "default": "none",
              "description": "Cloud STT adapter; must not be none when stt.backend is cloud.",
              "enum": [
                "none",
                "openai-compatible"
              ],
              "type": "string",
              "x-reload": "live",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "local": {
          "additionalProperties": false,
          "properties": {
            "model": {
              "default": "base.en",
              "description": "Local ASR model name.",
              "type": "string",
              "x-reload": "live",
              "x-ui": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "templates": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "default": "",
          "description": "Folder of note-template TOML files; empty means <config dir>/templates.",
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        }
      },
      "type": "object"
    }
  },
  "title": "oats-meetings-rs config",
  "type": "object"
}
