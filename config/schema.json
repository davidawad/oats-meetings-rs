        "single_instance": {
          "default": true,
          "description": "Refuse to start a second engine on the same control socket.",
          "type": "boolean",
          "x-reload": "lock",
          "x-ui": true
        }
      },
      "type": "object"
    },
    "audio": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "auto",
          "description": "Capture backend: auto picks per OS (Linux: pulse, else pipewire; Windows: cpal/WASAPI).",
          "enum": [
            "auto",
            "pulse",
            "pipewire",
            "cpal"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "layout": {
          "default": "split",
          "description": "WAV layout: split is two channels (left system audio, right mic); mix is one summed channel.",
          "enum": [
            "split",
            "mix"
          ],
          "type": "string",
          "x-reload": "live",
          "x-ui": true
        },
        "mic": {
          "additionalProperties": false,
          "properties": {
            "device": {
              "default": "",
              "description": "Microphone device id (see `ctl devices list`); empty means the default mic.",
              "type": "string",
              "x-reload": "live",
              "x-ui": true
            },
            "enabled": {
              "default": true,
              "description": "Record the microphone.",
              "type": "boolean",
              "x-reload": "live",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "open_timeout": {
          "default": "15s",
          "description": "How long a capture backend waits for audio to start flowing before giving up.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "5m",
          "x-max-ms": 300000,
          "x-min": "1s",
          "x-min-ms": 1000,
          "x-reload": "live",
          "x-ui": false
        },
        "poll_interval": {
          "default": "25ms",
          "description": "Pause of the recorder writer and of capture readiness polling.",
          "format": "duration",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string",
          "x-kind": "duration",
          "x-max": "1s",
          "x-max-ms": 1000,
          "x-min": "5ms",
          "x-min-ms": 5,
          "x-reload": "live",
          "x-ui": false
        },
        "system": {
          "additionalProperties": false,
          "properties": {
            "device": {
              "default": "",
              "description": "System-audio loopback device id (see `ctl devices list`); empty means the default loopback.",
              "type": "string",
              "x-reload": "live",
              "x-ui": true
            },
            "enabled": {
              "default": true,
              "description": "Record system audio (what the machine plays).",
              "type": "boolean",
              "x-reload": "live",
              "x-ui": true
            }
          },
          "type": "object"
        },
        "transcribe": {
          "default": "auto",
          "description": "Transcribe while recording (stt.* settings): on fails record-start if the ASR is unavailable, auto records audio only then, off never transcribes.",
