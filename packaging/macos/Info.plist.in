<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Oats Meetings</string>
  <key>CFBundleDisplayName</key><string>Oats Meetings</string>
  <key>CFBundleIdentifier</key><string>com.davidawad.oats-meetings-rs</string>
  <key>CFBundleExecutable</key><string>oats-meetings-rs</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSMicrophoneUsageDescription</key><string>Oats Meetings records meeting audio for transcription.</string>
  <key>NSScreenCaptureUsageDescription</key><string>Oats Meetings captures system audio (what the other people in a meeting say) through ScreenCaptureKit. No screen content is recorded.</string>
  <key>NSAudioCaptureUsageDescription</key><string>Oats Meetings captures system audio (what the other people in a meeting say) for transcription.</string>
  <key>NSCalendarsUsageDescription</key><string>Oats Meetings reads your calendar to name a recording after the meeting it overlaps.</string>
  <key>NSCalendarsFullAccessUsageDescription</key><string>Oats Meetings reads your calendar to name a recording after the meeting it overlaps, with its attendees.</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
