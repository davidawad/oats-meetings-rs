<?xml version="1.0" encoding="utf-8"?>
<!-- WiX 3 schema, built by wixl (msitools) in a Linux pod. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Oats Meetings" Language="1033" Version="$(env.OATS_VERSION)"
           Manufacturer="David Awad" UpgradeCode="6f1c2d3e-9a4b-4c5d-8e7f-0a1b2c3d4e5f">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"/>
    <MediaTemplate EmbedCab="yes"/>
    <Icon Id="AppIcon.ico" SourceFile="$(env.OATS_ICO)"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Oats Meetings">
          <Component Id="MainExe" Guid="a1b2c3d4-0001-4000-8000-000000000001" Win64="yes">
            <File Id="OatsExe" Name="oats-meetings-rs.exe" Source="$(env.OATS_EXE)" KeyPath="yes"/>
            <File Id="IconFile" Name="oats-meetings-rs.ico" Source="$(env.OATS_ICO)"/>
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartShortcut" Guid="a1b2c3d4-0002-4000-8000-000000000002" Win64="yes">
          <Shortcut Id="Shortcut" Name="Oats Meetings" Target="[INSTALLDIR]oats-meetings-rs.exe"
                    WorkingDirectory="INSTALLDIR" Icon="AppIcon.ico"/>
          <RegistryValue Root="HKCU" Key="Software\OatsMeetings" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="MainExe"/>
      <ComponentRef Id="StartShortcut"/>
    </Feature>
  </Product>
</Wix>
